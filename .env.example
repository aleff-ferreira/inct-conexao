# Plataforma de Seleções (Supabase) — copie para `.env` e preencha.
# Sem estes valores o site continua 100% estático (as rotas de inscrição/gestão
# mostram um aviso amigável). A anon key é pública por design; a segurança real
# está nas políticas RLS (supabase/migrations/001_platform.sql).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-ANON-KEY
